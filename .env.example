# 15-minute paper week (live / production default).
# Accelerated demo:
#   DEMO=1
#   CYCLE_MS=6000
DEMO=0
CYCLE_MS=900000

# Optional. If set, GET/POST /api/tick requires Authorization: Bearer $CRON_SECRET
# (Vercel Cron sends this automatically). Leave unset for an open paper tick.
# CRON_SECRET=

# Set automatically when a Vercel Blob store is linked (durable paper book).
# BLOB_READ_WRITE_TOKEN=

